<Window x:Class="TorusGateway.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TorusGateway"
        mc:Ignorable="d"
        Title="TORUS Gateway" Height="400" Width="1000"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 상단 컨트롤 영역 -->
        <Grid Grid.Row="0">
            <StackPanel HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <Button x:Name="ButtonTorusConnect" Content="TORUS Connect" Width="120" Click="Button_Click"/>
                    <Button x:Name="ButtonTorusSetting" Content="TORUS Settings" Width="120" Margin="5,0,0,0" Click="Button_Click"/>
                    <Button x:Name="ButtonDocs" Content="Docs" Width="60" Margin="5,0,0,0" Click="Button_Click"/>
                    <Button x:Name="ButtonTestRequest" Content="Test Request" Width="100" Margin="5,0,0,0" Click="Button_Click"/>
                    <Button x:Name="ButtonNcExplorer" Content="NC Explorer" Width="100" Margin="5,0,0,0" Click="Button_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <Button x:Name="ButtonWebServerOpen" Content="WebServer Open" Width="120" Click="Button_Click"/>
                    <Button x:Name="ButtonWebServerClose" Content="WebServer Close" Width="120" Margin="5,0,0,0" Click="Button_Click"/>
                    <TextBlock Text="Server Host:" FontFamily="Consolas" VerticalAlignment="Center" Margin="15,0,5,0"/>
                    <TextBox x:Name="TextBoxWebServerHost" FontFamily="Consolas" Width="120" VerticalAlignment="Center"/>
                    <TextBlock Text="Server Port:" FontFamily="Consolas" VerticalAlignment="Center" Margin="15,0,5,0"/>
                    <TextBox x:Name="TextBoxWebServerPort" FontFamily="Consolas" Width="80" VerticalAlignment="Center"/>
                    <TextBlock Text="Access:" FontFamily="Consolas" VerticalAlignment="Center" Margin="15,0,8,0"/>
                    <RadioButton x:Name="RadioAccessAll" Content="Allow All" GroupName="AccessMode"
                                 VerticalAlignment="Center" Margin="0,0,12,0" Checked="RadioAccess_Checked"/>
                    <RadioButton x:Name="RadioAccessLocal" Content="Local Only" GroupName="AccessMode"
                                 VerticalAlignment="Center" Margin="0,0,12,0" Checked="RadioAccess_Checked"
                                 ToolTip="127.0.0.1 (same PC only)"/>
                    <RadioButton x:Name="RadioAccessSpecific" Content="Specify IPs" GroupName="AccessMode"
                                 VerticalAlignment="Center" Checked="RadioAccess_Checked"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button x:Name="ButtonAbout" Content="About" Width="60" Click="Button_Click"/>
                <Button x:Name="ButtonMinimizeToTray" Content="To Tray" Width="80" Margin="5,0,0,0" Click="Button_Click"/>
                <Button x:Name="ButtonExit" Content="Exit" Width="60" Margin="5,0,0,0" Click="Button_Click"/>
            </StackPanel>
        </Grid>

        <!-- 로그/콘솔 통합 영역. 상단 탭 헤더(MainTabs)로 선택하고, 콘텐츠는 아래 ContentArea가 담당.
             콘솔 HWND가 탭 전환으로 파괴되지 않도록 모든 콘텐츠를 항상 트리에 두고 Visibility만 토글한다. -->
        <DockPanel Grid.Row="1" Margin="0,10,0,0">
            <!-- 헤더 전용 탭(콘텐츠 프레젠터 없는 템플릿) → 빈 콘텐츠 영역/언로드 문제 제거.
                 탭 스트립 하단 기준선 + 각 탭 테두리로 경계를 명확히 보이게 한다. -->
            <TabControl x:Name="MainTabs" DockPanel.Dock="Top" SelectionChanged="MainTabs_SelectionChanged">
                <TabControl.Resources>
                    <!-- 탭 헤더 스타일: 상/좌/우 테두리 + 둥근 상단, 선택 시 흰 배경으로 강조 -->
                    <Style TargetType="TabItem">
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="bd" Margin="1,0,0,0"
                                            Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1,1,1,0" CornerRadius="4,4,0,0">
                                        <ContentPresenter ContentSource="Header"
                                                          Margin="12,5"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <!-- 선택 탭: 흰 배경 + 위로 살짝 올려 기준선과 이어지게 -->
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource BackgroundBrush}"/>
                                            <Setter TargetName="bd" Property="Panel.ZIndex" Value="1"/>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                                <Condition Property="IsSelected" Value="False"/>
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBgBrush}"/>
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <!-- 탭 스트립 하단 기준선(1px)으로 로그/콘솔 영역과의 경계를 명확히 -->
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <TabPanel IsItemsHost="True" Margin="2,2,0,0"/>
                        </Border>
                    </ControlTemplate>
                </TabControl.Template>
                <TabItem Header="API Log"/>
            </TabControl>
            <Grid x:Name="ContentArea">
            <Grid x:Name="LogArea">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="API Request Log" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="4,0,0,4"/>
            <!-- GET(위) / POST(아래) 로그 분리. 가운데 GridSplitter로 높이 조절 -->
            <Grid Grid.Row="1" Grid.Column="0">
                <Grid.Resources>
                    <!-- 두 로그 패널 공용 ListBox 스타일 (콘솔 풍 녹색 모노스페이스) -->
                    <Style x:Key="LogListBox" TargetType="ListBox">
                        <Setter Property="Background" Value="#0C0C0C"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                        <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
                        <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling"/>
                        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
                        <Setter Property="ItemContainerStyle">
                            <Setter.Value>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Foreground" Value="#00FF41"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Padding" Value="4,1"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Grid.Resources>
                <!-- GET 정기 / GET 간헐 / POST 세 칸을 동일 높이(*)로 두고, 사이를 GridSplitter로 조절 -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- GET — 정기(주기): 횟수/주기/마지막 시각을 in-place 갱신 -->
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="GET — Regular (periodic)" FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}" Margin="4,0,0,2"/>
                    <ListView Grid.Row="1" x:Name="ListViewGetRegular"
                              Background="#0C0C0C" BorderBrush="{StaticResource BorderBrush}"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Foreground" Value="#00FF41"/>
                                <Setter Property="FontFamily" Value="Consolas"/>
                                <Setter Property="FontSize" Value="11"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="IP" Width="110" DisplayMemberBinding="{Binding Ip}"/>
                                <GridViewColumn Header="Request" Width="340" DisplayMemberBinding="{Binding Request}"/>
                                <GridViewColumn Header="Count" Width="60" DisplayMemberBinding="{Binding Count}"/>
                                <GridViewColumn Header="Period" Width="70" DisplayMemberBinding="{Binding Period}"/>
                                <GridViewColumn Header="Last" Width="75" DisplayMemberBinding="{Binding Last}"/>
                                <GridViewColumn Header="Status" Width="55" DisplayMemberBinding="{Binding Status}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>

                <GridSplitter Grid.Row="1" Height="4" Margin="0,4"
                              HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                              Background="{StaticResource BorderBrush}"/>

                <!-- GET — 간헐: 처음 보거나 아직 주기로 승격 안 된 GET이 흐름 -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="GET — Intermittent" FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}" Margin="4,0,0,2"/>
                    <ListBox Grid.Row="1" x:Name="ListBoxGetIntermittent" Style="{StaticResource LogListBox}"/>
                </Grid>

                <GridSplitter Grid.Row="3" Height="4" Margin="0,4"
                              HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                              Background="{StaticResource BorderBrush}"/>

                <!-- POST (POST 외 메서드도 여기로 모임) -->
                <Grid Grid.Row="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="POST" FontSize="11"
                               Foreground="{StaticResource SecondaryTextBrush}" Margin="4,0,0,2"/>
                    <ListBox Grid.Row="1" x:Name="ListBoxApiLogPost" Style="{StaticResource LogListBox}"/>
                </Grid>
            </Grid>

            <!-- IP 지정 패널: 로그 우측에 배치. Visibility 토글 시 로그의 가로 폭만 변하고 세로는 그대로 유지됨 -->
            <Border x:Name="PanelAllowedIPs"
                    Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                    Margin="10,0,0,0"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Padding="6"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Allowed IPs" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBox x:Name="TextBoxNewIP" FontFamily="Consolas" Width="200" VerticalAlignment="Center"
                                 ToolTip="IP or CIDR. e.g., 192.168.1.10 or 192.168.1.0/24"/>
                        <Button x:Name="ButtonAddIP" Content="Add" Width="50" Margin="5,0,0,0" Click="Button_Click"/>
                        <Button x:Name="ButtonRemoveIP" Content="Remove" Width="70" Margin="5,0,0,0" Click="Button_Click"/>
                    </StackPanel>
                    <ListBox Grid.Row="2" x:Name="ListBoxAllowedIPs" Width="340" FontFamily="Consolas"/>
                </Grid>
            </Border>
            </Grid>
            <!-- 콘솔 호스트들(동적 생성). 항상 트리에 존재하고 Visibility로만 표시 전환 → HWND 보존 -->
            <Grid x:Name="ConsoleHostGrid" Visibility="Collapsed"/>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
