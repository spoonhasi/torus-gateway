<Window x:Class="TorusGateway.Torus.MachineListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:torusControl="clr-namespace:TorusGateway.Torus"
        Title="TORUS Settings" Height="650" Width="1200"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <Grid>
        <torusControl:MachineListControl ConfigFilePath="config.ini"/>
    </Grid>
</Window>
