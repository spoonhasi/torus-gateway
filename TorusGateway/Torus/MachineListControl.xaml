<UserControl x:Class="TorusGateway.Torus.MachineListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TorusGateway.Torus"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="1100">
    <UserControl.Resources>
        <!-- Row 2 입력 영역의 ComboBox/TextBox 높이 통일 -->
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="3,2,6,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Row 0: 설명 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="This menu allows editing of Torus settings (such as MachineList.xml). Because Torus is a shared platform, changing its settings from an external app may cause unexpected errors in other apps using Torus." TextWrapping="Wrap"/>
            <TextBlock Text="As a rule, Torus settings should be modified from Torus itself. This is a test utility and exposes a limited subset of Torus settings for testing convenience only." TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Row 1: 경로 설정 (Border로 시각적 그룹화) -->
        <Border Grid.Row="1" Margin="0,0,0,10"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 경로 행들 (단일 Grid로 컬럼 정렬) -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Torus Run Path:" VerticalAlignment="Center" Margin="0,3"/>
                    <Button    Grid.Row="0" Grid.Column="1" x:Name="ButtonTorusRunPath" Content="Browse" Width="90" Margin="5,3" Click="Button_Click"/>
                    <Button    Grid.Row="0" Grid.Column="2" x:Name="ButtonTorusRunExecute" Content="Run Torus" Width="90" Margin="5,3" Click="Button_Click"/>
                    <TextBox   Grid.Row="0" Grid.Column="3" x:Name="TextBoxTorusRunPath" Margin="5,3,0,3"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Torus Exit Path:" VerticalAlignment="Center" Margin="0,3"/>
                    <Button    Grid.Row="1" Grid.Column="1" x:Name="ButtonTorusExitPath" Content="Browse" Width="90" Margin="5,3" Click="Button_Click"/>
                    <Button    Grid.Row="1" Grid.Column="2" x:Name="ButtonTorusExitExecute" Content="Exit Torus" Width="90" Margin="5,3" Click="Button_Click"/>
                    <TextBox   Grid.Row="1" Grid.Column="3" x:Name="TextBoxTorusExitPath" Margin="5,3,0,3"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="MachineList.xml Path:" VerticalAlignment="Center" Margin="0,3"/>
                    <Button    Grid.Row="2" Grid.Column="1" x:Name="ButtonTorusMachineListPath" Content="Browse" Width="90" Margin="5,3" Click="Button_Click"/>
                    <TextBox   Grid.Row="2" Grid.Column="3" x:Name="TextBoxTorusMachineListPath" Margin="5,3,0,3"/>
                </Grid>

                <!-- 경로 저장/로드 버튼 -->
                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                    <Button x:Name="ButtonTorusPathSave" Content="Save Paths" Width="90" Click="Button_Click" Margin="0,3"/>
                    <Button x:Name="ButtonTorusPathLoad" Content="Load Paths" Width="90" Click="Button_Click" Margin="0,3"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 2: MachineList 편집 영역 (파일 액션 툴바 + 속성 편집) -->
        <Border Grid.Row="2" Margin="0,0,0,10"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 파일 액션 툴바 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button x:Name="ButtonTorusMachineListRead" Content="Read MachineList.xml" Width="160" Margin="0,0,5,0" Click="Button_Click"/>
                    <Button x:Name="ButtonTorusMachineListWrite" Content="Write MachineList.xml" Width="160" Margin="0,0,15,0" Click="Button_Click"/>
                    <TextBlock x:Name="TextBlockSaveStatus" Text="Unsaved changes" Foreground="Red" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 속성 편집 영역 -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 좌측 필드 (activate ~ port) -->
                    <StackPanel Grid.Column="0" Margin="0,0,15,0">
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="activate :" Width="85" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ComboBoxTorusNcMachineActivate" Width="150" SelectionChanged="ComboBox_SelectionChanged">
                        <ComboBoxItem Content="True"/>
                        <ComboBoxItem Content="False"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="name :" Width="85" VerticalAlignment="Center"/>
                    <TextBox x:Name="TextBoxTorusNcMachineName" Width="150" TextChanged="TextBox_TextChanged"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="id :" Width="85" VerticalAlignment="Center"/>
                    <TextBox x:Name="TextBoxTorusNcMachineId" Width="150" TextChanged="TextBox_TextChanged"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="vendorCode :" Width="85" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ComboBoxTorusNcMachineVendorCode" Width="150" SelectionChanged="ComboBox_SelectionChanged">
                        <ComboBoxItem Content="FANUC"/>
                        <ComboBoxItem Content="SIEMENS"/>
                        <ComboBoxItem Content="CSCAM"/>
                        <ComboBoxItem Content="MITSUBISHI"/>
                        <ComboBoxItem Content="KCNC"/>
                        <ComboBoxItem Content="MAZAK"/>
                        <ComboBoxItem Content="HEIDENHAIN"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="address :" Width="85" VerticalAlignment="Center"/>
                    <TextBox x:Name="TextBoxTorusNcMachineAddress" Width="150" TextChanged="TextBox_TextChanged"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="port :" Width="85" VerticalAlignment="Center"/>
                    <TextBox x:Name="TextBoxTorusNcMachinePort" Width="150" TextChanged="TextBox_TextChanged"/>
                </StackPanel>
            </StackPanel>

            <!-- 우측 필드 (exDllPath ~ password) -->
            <StackPanel Grid.Column="1" Margin="0,0,15,0">
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="exDllPath :" Width="105" VerticalAlignment="Center"/>
                    <TextBox x:Name="TextBoxTorusNcMachineExDllPath" Width="270" TextChanged="TextBox_TextChanged"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="connectCode :" Width="105" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ComboBoxTorusNcMachineConnectCode" Width="270" SelectionChanged="ComboBox_SelectionChanged">
                        <ComboBoxItem Content="Default"/>
                        <ComboBoxItem Content="Ethernet"/>
                        <ComboBoxItem Content="OPCUA"/>
                        <ComboBoxItem Content="HSSB"/>
                        <ComboBoxItem Content="MyHMI"/>
                        <ComboBoxItem Content="MTConnect"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="ncVersionCode :" Width="105" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ComboBoxTorusNcMachineNcVersionCode" Width="270" SelectionChanged="ComboBox_SelectionChanged">
                        <ComboBoxItem Content="Default"/>
                        <ComboBoxItem Content="MitsubishiM700M"/>
                        <ComboBoxItem Content="MitsubishiM700L"/>
                        <ComboBoxItem Content="MitsubishiM800M"/>
                        <ComboBoxItem Content="MitsubishiM800L"/>
                        <ComboBoxItem Content="Siemens45"/>
                        <ComboBoxItem Content="Siemens47"/>
                        <ComboBoxItem Content="Siemens48"/>
                        <ComboBoxItem Content="Siemens49"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="toolSystem :" Width="105" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ComboBoxTorusNcMachineToolSystem" Width="270" SelectionChanged="ComboBox_SelectionChanged">
                        <ComboBoxItem Content="Default"/>
                        <ComboBoxItem Content="ToolLife"/>
                        <ComboBoxItem Content="ToolManager"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="username :" Width="105" VerticalAlignment="Center"/>
                    <TextBox x:Name="TextBoxTorusNcMachineUsername" Width="270" TextChanged="TextBox_TextChanged"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="password :" Width="105" VerticalAlignment="Center"/>
                    <TextBox x:Name="TextBoxTorusNcMachinePassword" Width="270" TextChanged="TextBox_TextChanged"/>
                </StackPanel>
            </StackPanel>

                    <!-- Machine 추가/삭제 버튼 -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                        <Button x:Name="ButtonTorusMachineListItemAdd" Content="Add Machine" Margin="0,2" Click="Button_Click"/>
                        <Button x:Name="ButtonTorusMachineListItemRemove" Content="Remove Selected" Margin="0,2" Click="Button_Click"/>
                    </StackPanel>
                    <!-- 정렬/순서 이동 버튼 -->
                    <StackPanel Grid.Column="3" VerticalAlignment="Bottom" Margin="5,0,0,0">
                        <Button x:Name="ButtonTorusMachineListArrange" Content="Sort by ID" Margin="0,2" Click="Button_Click"/>
                        <Button x:Name="ButtonTorusMachineListMoveUp" Content="Move Up" Margin="0,2" Click="Button_Click"/>
                        <Button x:Name="ButtonTorusMachineListMoveDown" Content="Move Down" Margin="0,2" Click="Button_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Row 3: Machine 목록 -->
        <ListView Grid.Row="3" x:Name="ListViewMachineList" d:ItemsSource="{d:SampleData ItemCount=2}" SelectionChanged="ListView_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="activate" DisplayMemberBinding="{Binding activate}" Width="55"/>
                    <GridViewColumn Header="name" DisplayMemberBinding="{Binding name}" Width="90"/>
                    <GridViewColumn Header="id" DisplayMemberBinding="{Binding id}" Width="40"/>
                    <GridViewColumn Header="vendorCode" DisplayMemberBinding="{Binding vendorCode}" Width="80"/>
                    <GridViewColumn Header="address" DisplayMemberBinding="{Binding address}" Width="120"/>
                    <GridViewColumn Header="port" DisplayMemberBinding="{Binding port}" Width="55"/>
                    <GridViewColumn Header="exDllPath" DisplayMemberBinding="{Binding exDllPath}" Width="140"/>
                    <GridViewColumn Header="connectCode" DisplayMemberBinding="{Binding connectCode}" Width="85"/>
                    <GridViewColumn Header="ncVersionCode" DisplayMemberBinding="{Binding ncVersionCode}" Width="90"/>
                    <GridViewColumn Header="toolSystem" DisplayMemberBinding="{Binding toolSystem}" Width="70"/>
                    <GridViewColumn Header="username" DisplayMemberBinding="{Binding username}" Width="80"/>
                    <GridViewColumn Header="password" DisplayMemberBinding="{Binding password}" Width="80"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>
