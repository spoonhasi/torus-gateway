<Window x:Class="TorusGateway.TestRequestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TORUS Gateway - Test Request"
        Height="600" Width="900"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Method + URL 라인 -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" x:Name="ComboMethod" Width="80" SelectionChanged="ComboMethod_SelectionChanged">
                <ComboBoxItem Content="GET" IsSelected="True"/>
                <ComboBoxItem Content="PUT"/>
                <ComboBoxItem Content="DELETE"/>
            </ComboBox>
            <TextBox Grid.Column="1" x:Name="TextBoxBaseUrl" FontFamily="Consolas" Width="220" Margin="5,0,0,0" VerticalContentAlignment="Center"/>
            <TextBox Grid.Column="2" x:Name="TextBoxPath" FontFamily="Consolas" Margin="5,0,0,0" VerticalContentAlignment="Center"
                     ToolTip="e.g., /machineList or /machine/channel/axis/machinePosition?machine=1&amp;channel=1&amp;axis=1"/>
            <Button Grid.Column="3" x:Name="ButtonSend" Content="Send" Width="80" Margin="5,0,0,0" Click="ButtonSend_Click"/>
        </Grid>

        <!-- Body 레이블 -->
        <TextBlock Grid.Row="1" x:Name="LabelBody" Text="Request Body (JSON)"
                   FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="4,0,0,4"/>

        <!-- Body textarea -->
        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <TextBox x:Name="TextBoxBody"
                     FontFamily="Consolas" FontSize="12"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     Background="Transparent" Foreground="{StaticResource TextBrush}"
                     BorderThickness="0"
                     Padding="6"/>
        </Border>

        <!-- Response 레이블 -->
        <TextBlock Grid.Row="3" x:Name="LabelResponse" Text="Response" FontSize="11"
                   Foreground="{StaticResource SecondaryTextBrush}" Margin="4,10,0,4"/>

        <!-- Response 본문 -->
        <Border Grid.Row="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <TextBox x:Name="TextBoxResponse"
                     FontFamily="Consolas" FontSize="12"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     Background="Transparent" Foreground="{StaticResource TextBrush}"
                     BorderThickness="0"
                     Padding="6"/>
        </Border>

        <!-- 하단 Close -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="ButtonClose" Content="Close" Width="80" Click="ButtonClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
