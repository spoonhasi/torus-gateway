<Window x:Class="TorusGateway.NcExplorerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TORUS Gateway - NC File Explorer"
        Height="600" Width="800"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 설비 선택 -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Machine:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Grid.Column="1" x:Name="ComboMachine" Width="320" HorizontalAlignment="Left"
                      DisplayMemberPath="Display"
                      SelectionChanged="ComboMachine_SelectionChanged"/>
        </Grid>

        <!-- 루트 경로 레이블 -->
        <TextBlock Grid.Row="1" Text="Root Path" FontSize="11"
                   Foreground="{StaticResource SecondaryTextBrush}" Margin="4,0,0,4"/>

        <!-- 루트 경로 값 (data://machine/ncMemory/rootPath 조회 결과) -->
        <TextBox Grid.Row="2" x:Name="TextBoxRootPath" FontFamily="Consolas"
                 IsReadOnly="True" Margin="0,0,0,10"/>

        <!-- 파일/폴더 목록 영역: 목록 조회 API 연동 시 ListView로 교체 예정 -->
        <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <TextBlock x:Name="TextBlockListingPlaceholder"
                       Text="File / folder listing will appear here once the TORUS list API is integrated."
                       Foreground="{StaticResource SecondaryTextBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="20"/>
        </Border>

        <!-- 하단 Close -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="ButtonClose" Content="Close" Width="80" Click="ButtonClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
