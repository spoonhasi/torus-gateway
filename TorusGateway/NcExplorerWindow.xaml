<Window x:Class="TorusGateway.NcExplorerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TORUS Gateway - NC File Explorer"
        Height="600" Width="800"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 설비 선택 -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Machine:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Grid.Column="1" x:Name="ComboMachine" Width="320" HorizontalAlignment="Left"
                      DisplayMemberPath="Display"
                      SelectionChanged="ComboMachine_SelectionChanged"/>
        </Grid>

        <!-- 루트 경로 레이블 -->
        <TextBlock Grid.Row="1" Text="Root Path" FontSize="11"
                   Foreground="{StaticResource SecondaryTextBrush}" Margin="4,0,0,4"/>

        <!-- 루트 경로 값 (data://machine/ncMemory/rootPath 조회 결과) -->
        <TextBox Grid.Row="2" x:Name="TextBoxRootPath" FontFamily="Consolas"
                 IsReadOnly="True" Margin="0,0,0,10"/>

        <!-- 네비게이션 바: 현재 경로 + 상태 (상위 이동은 목록 첫 항목 "..." 사용) -->
        <Grid Grid.Row="3" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="TextBoxCurrentPath" FontFamily="Consolas"
                     IsReadOnly="True" VerticalContentAlignment="Center"/>
            <TextBlock Grid.Column="1" x:Name="TextBlockStatus" VerticalAlignment="Center"
                       Margin="8,0,0,0" Foreground="{StaticResource SecondaryTextBrush}"/>
        </Grid>

        <!-- 파일/폴더 목록 (첫 항목 "..."은 상위 폴더로 이동) -->
        <ListView Grid.Row="4" x:Name="ListViewEntries"
                  MouseDoubleClick="ListViewEntries_MouseDoubleClick"
                  SelectionChanged="ListViewEntries_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" Width="380" DisplayMemberBinding="{Binding DisplayName}"/>
                    <GridViewColumn Header="Size" Width="120" DisplayMemberBinding="{Binding SizeDisplay}"/>
                    <GridViewColumn Header="Modified" Width="200" DisplayMemberBinding="{Binding Modified}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- 하단 버튼 줄: 좌측 업/다운로드, 우측 Close -->
        <Grid Grid.Row="5" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="ButtonDownload" Content="Download" Width="90"
                        Click="ButtonDownload_Click" IsEnabled="False"
                        ToolTip="Download the selected file to your PC"/>
                <Button x:Name="ButtonUpload" Content="Upload" Width="90" Margin="8,0,0,0"
                        Click="ButtonUpload_Click" IsEnabled="False"
                        ToolTip="Upload a file from your PC to the current folder"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ButtonClose" Content="Close" Width="80" Click="ButtonClose_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
